{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C1PH0N1C",
  "version": "0.3.0",
  "identifier": "dev.volna.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "C1PH0N1C",
        "width": 800,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "transparent": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": ["micaDark"]
        }
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
